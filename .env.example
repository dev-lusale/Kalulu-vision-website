# ── Database (PostgreSQL, e.g. Neon via Vercel Storage) ─────────────
# Vercel's Neon integration sets these automatically (also accepted:
# kaluluvision_POSTGRES_PRISMA_URL / kaluluvision_POSTGRES_URL_NON_POOLING).
DATABASE_URL=postgresql://user:password@host/db?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://user:password@host/db?sslmode=require

# ── Admin authentication ────────────────────────────────────────────
# Long random string (at least 32 characters). Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=
# First admin: while the admins table is empty, signing in with these
# creates the account. Password must be at least 10 characters.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ── Site URL (used for canonical links, sitemap and social previews) ──
NEXT_PUBLIC_SITE_URL=https://kalulu-vision-website.vercel.app
